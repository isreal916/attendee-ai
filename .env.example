# Copy to .env and fill in. Never commit .env.

# Walrus Memory: create the account + delegate key at
# https://staging.memory.walrus.xyz (testnet) or https://memory.walrus.xyz (mainnet)
MEMWAL_ACCOUNT_ID=
MEMWAL_PRIVATE_KEY=
MEMWAL_SERVER_URL=https://relayer-staging.memory.walrus.xyz

# Model: DeepSeek key from https://platform.deepseek.com
# (or set GROQ_API_KEY instead for Groq's free tier; any OpenAI-compatible API works via LLM_BASE_URL)
DEEPSEEK_API_KEY=

# HR data source: "mock" (seeded demo company) or "attendeehrm"
HR_ADAPTER=mock
ATTENDEE_API_URL=

# Memory index. Leave empty to use a local SQLite file (data/attendee-ai.db).
# Set to a Postgres connection string (e.g. Neon) on hosts without a persistent disk.
DATABASE_URL=

# Optional
# LLM_MODEL=deepseek-v4-pro
# LLM_EXTRACT_MODEL=deepseek-flash
# MEMORY_BACKEND=mock            # force the in-process memory (no Walrus account needed)
# CORS_ORIGINS=http://localhost:3000
# PORT=8787
